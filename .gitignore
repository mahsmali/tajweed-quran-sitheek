out/
tsconfig.tsbuildinfo

# Local HTTPS development.
# `.certs/` holds a self-signed certificate AND ITS PRIVATE KEY, generated by
# `npm run dev:https` so a phone on the LAN can reach a secure origin. A private
# key must never be committed, even a throwaway development one.
.certs/

