{
  "name": "tajweed-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=2560 ./node_modules/next/dist/bin/next dev --webpack -p 3000",
    "build": "node --max-old-space-size=3072 ./node_modules/next/dist/bin/next build --webpack",
    "dev:https": "node scripts/dev-https.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed": "node --no-warnings --import ./scripts/register.mjs scripts/build-dataset.ts",
    "test:audio": "node --no-warnings --import ./scripts/register.mjs scripts/test-compare.ts",
    "check:alphabet": "node --no-warnings --import ./scripts/register.mjs scripts/check-alphabet.ts"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wavesurfer.js": "^7.8.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.135.0"
  }
}
